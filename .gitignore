# Per-car data stays on this laptop: recordings, probe results, VIN, fuel/battery state.
# Only each car's settings (car.json) and its own web design (ui/) are shared.
cars/*/*
!cars/*/car.json
!cars/*/ui/
cars/active_car.txt

# old location of recordings (before the cars/ folders) and adapter logs
recordings/
obd.log

# Python
__pycache__/
*.pyc
.venv/
venv/

# state files from before the cars/ folders
fuel_state.json
fuel_state.json.tmp
battery_state.json
battery_state.json.tmp
